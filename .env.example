# Connect to Postgres via Supabase Pooler (host: aws-0-ap-southeast-2.pooler.supabase.com, user: postgres.pywvcewijtwxbezzglrr)
# Session pooler (port 5432) or Transaction pooler (port 6543)
DATABASE_URL="postgresql://postgres.pywvcewijtwxbezzglrr:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

# Supabase API keys & Project Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# JWT & Authentication (Custom JWT, no expiration)
JWT_SECRET=super_secret_jwt_key_replace_with_strong_random_secret_in_prod
BCRYPT_SALT=10

# Initial Onboarding Seed Credentials
SUPERADMIN_EMAIL=superadmin@platform.local
SUPERADMIN_PASSWORD=SuperAdmin#2026!

# Server Port & Environment
PORT=4000
NODE_ENV=development