# Database & Supabase (Postgres connection string via pooler or direct connection)
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# Supabase API keys
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# JWT & Authentication (Custom JWT, no expiration)
JWT_SECRET=super_secret_jwt_key_replace_with_strong_random_secret_in_prod
BCRYPT_SALT=10

# Initial Onboarding Seed Credentials
SUPERADMIN_EMAIL=superadmin@platform.local
SUPERADMIN_PASSWORD=SuperAdmin#2026!

# Server Port & Environment
PORT=4000
NODE_ENV=development